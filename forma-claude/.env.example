# Forma Claude â€” server configuration
# Copy to .env and fill in. Never commit the filled file.

# â”€â”€ core â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PORT=8080
PUBLIC_ORIGIN=https://forma-claude.example

# Persistent directory for the license database, the signing key and release
# assets. Leave unset locally. On Railway mount a volume and set /data.
FORMA_DATA_DIR=

# Admin console
ADMIN_PATH=ops
ADMIN_PASSWORD=change-me-to-32-random-characters
ADMIN_SESSION_SECRET=change-me-too

# â”€â”€ checkpoint â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# linkvertise : the real flow. A static Linkvertise link whose destination is
#               https://<host>/get-key/return. Linkvertise appends ?hash=â€¦ when
#               the ad is finished and the server checks that hash with the
#               publisher API before minting a key.
# postback    : a provider calls /v1/linkvertise/postback with a shared secret.
# direct      : no checkpoint. Development only.
CHECKPOINT_MODE=linkvertise
CHECKPOINT_SECRET=change-me-too
CHECKPOINT_TIER=trial
CHECKPOINT_COOLDOWN_SECONDS=60
# How long a key stays valid after its last successful check-in. Every check-in
# slides the window forward, so an app in use never runs out.
KEY_WINDOW_HOURS=5
CHECKPOINT_IP_LIMIT=6

# Linkvertise
# Publisher API token (dashboard -> publisher -> API). Required to verify hashes.
LINKVERTISE_TOKEN=
# The public short link. Its destination must be https://<host>/get-key/return
LINKVERTISE_URL=
# Optional postback shared secret, only for CHECKPOINT_MODE=postback.
LINKVERTISE_POSTBACK_SECRET=
# Override the verification endpoint (tests only).
LINKVERTISE_VERIFY_URL=

# â”€â”€ releases â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Assets are served from <FORMA_DATA_DIR>/releases. PUBLIC_ORIGIN must match the
# host users reach, because the signed manifest embeds absolute asset URLs.

# â”€â”€ discord (tools/discord-provision.mjs) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1570904679960027197
FORMA_SITE=https://forma-claude.example
DOWNLOAD_URL=https://forma-claude.example/downloads/FormaClaude-Setup.exe
VERIFIED_ROLE_ID=
